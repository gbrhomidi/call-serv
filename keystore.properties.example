# For local Release builds only. Copy to keystore.properties and fill locally.
# Never commit keystore.properties or the keystore file.
# The Android Gradle build reads KEYSTORE_FILE/KEYSTORE_PASSWORD/KEY_ALIAS/KEY_PASSWORD
# from the environment first; these properties are a local-only fallback.
storeFile=/absolute/path/to/call-serv.jks
storePassword=REPLACE_WITH_LOCAL_STORE_PASSWORD
keyAlias=call-serv
keyPassword=REPLACE_WITH_LOCAL_KEY_PASSWORD
